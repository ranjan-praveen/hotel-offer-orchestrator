{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "_postman_id": "hotel-offer-orchestrator",
    "description": "API tests for the Hotel Offer Orchestrator assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Get hotels - Delhi",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            }
          ]
        }
      }
    },
    {
      "name": "Get hotels - Delhi price range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5500&maxPrice=7000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            },
            {
              "key": "minPrice",
              "value": "5500"
            },
            {
              "key": "maxPrice",
              "value": "7000"
            }
          ]
        }
      }
    },
    {
      "name": "Get hotels - No results",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=mumbai",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "mumbai"
            }
          ]
        }
      }
    }
  ]
}